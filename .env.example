# ---- storage -------------------------------------------------------------
VECTOR_BACKEND=sqlite                 # sqlite | pgvector
DATABASE_URL=sqlite:///./realestate.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_db

# ---- embeddings ----------------------------------------------------------
EMBEDDING_PROVIDER=hash               # hash | openai | voyage
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Changing the provider invalidates every stored vector — reindex afterwards.

# ---- language model ------------------------------------------------------
LLM_PROVIDER=stub                     # stub | anthropic | openai
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ---- WhatsApp (Meta Cloud API) -------------------------------------------
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=                  # set this in production: unsigned webhooks are accepted while blank

# ---- auth & secrets ------------------------------------------------------
# Leave STAFF_API_KEYS blank and a new key is generated at every restart, so
# you are locked out of the Team, Revenue and Playbook tabs between reboots.
STAFF_API_KEYS=
REQUIRE_AUTH=true

# Encryption at rest for uploaded title documents. Blank means they sit in
# plaintext on disk. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOCUMENT_KEY=

# ---- the agent -----------------------------------------------------------
# Virtual staging renders only when one of these is set; without it the
# staging tool returns a plan and says so rather than faking an image.
REPLICATE_API_TOKEN=

# ---- behaviour -----------------------------------------------------------
ENFORCE_VERIFICATION_GATE=true        # never ship false
DEFAULT_RESULT_LIMIT=3
CORS_ORIGINS=http://localhost:3000
